# Any ONE of these is enough. Grok is the default/preferred engine.
XAI_API_KEY=

# Alternatives (auto-detected in this order if XAI_API_KEY is unset):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides:
# LLM_MODEL=grok-4.6                                  # reasoning model (approval/critique)
# LLM_EXTRACTION_MODEL=grok-4.20-0309-non-reasoning   # fast model for extraction (xAI default)
# LLM_API_KEY=...   LLM_BASE_URL=...   LLM_MODEL=...  # any OpenAI-compatible endpoint
